# --- Telegram bot ---
# Bot token from @BotFather (required)
BOT_TOKEN=
# Secret token shared with Telegram (set via setWebhook secret_token)
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of the Railway deployment (https://<app>.up.railway.app)
WEBHOOK_URL=

# --- Supabase (service role) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin owner ---
# Telegram ID of the owner (falls back to 5583787103 if unset)
ADMIN_ID=

# --- n8n integration (optional) ---
N8N_WEBHOOK_URL=

# --- Reels Python microservice (optional) ---
REELS_SERVICE_URL=
REELS_SECRET=
