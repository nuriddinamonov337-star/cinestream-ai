# --- Telegram bot ---
# Bot token from @BotFather (required). The bot calls api.telegram.org directly.
BOT_TOKEN=
# Secret token shared with Telegram (set the same value via setWebhook's secret_token).
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of the deployment, used to register the webhook (e.g. https://<app>.up.railway.app).
WEBHOOK_URL=

# --- Supabase (server-side, service role) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable (anon) keys are exposed to the browser; safe to commit but kept here for dev parity.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# --- Admin owner ---
# Telegram ID of the owner (falls back to the previous hardcoded value if unset).
ADMIN_ID=

# --- n8n integrations (optional) ---
N8N_WEBHOOK_URL=
N8N_REELS_WEBHOOK_URL=

# --- Reels Python microservice (optional) ---
REELS_SERVICE_URL=
REELS_SECRET=
